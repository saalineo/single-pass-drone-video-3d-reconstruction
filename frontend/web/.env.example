# Base URL for mission-svc REST API
VITE_API_BASE_URL=http://localhost:8080/v1

# Base URL for status/live-feed WebSockets (used from day-26)
VITE_WS_BASE_URL=ws://localhost:8080/v1

# Cesium ion access token for terrain/imagery base layers (day-26 MapViewer)
VITE_CESIUM_ION_TOKEN=

# Optional path to Draco decoder WASM if the mesher emits Draco-compressed GLBs
VITE_GLTF_DRACO_DECODER_PATH=
    